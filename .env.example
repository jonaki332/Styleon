# Server port (Render automatically injects PORT; defaults to 3000 locally)
PORT=

# Set to "production" on Render Web Services so Express serves dist/
NODE_ENV=

# Public application URL (e.g., https://your-service.onrender.com)
APP_URL=

# Required server-side password to authenticate into /admin
ADMIN_PASSWORD=

# Recommended HMAC secret for signing admin session cookies (minimum 16 characters)
SESSION_SECRET=

# Recommended persistent storage directory on Render (e.g., /var/data mounted to a Render Persistent Disk)
DATA_DIR=

# Optional Gemini API key if enabling server-side AI integrations
GEMINI_API_KEY=
